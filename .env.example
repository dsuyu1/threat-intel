# -----------------------------------------------------------------------------
# Threat Intel Platform — example environment file
#
# Copy to `.env.local` (repo root) and fill in values.
# -----------------------------------------------------------------------------

# Database (Neon / Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------

# openai | gemini
AI_PROVIDER="openai"

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=""
# Optional (only needed for OpenAI-compatible providers)
OPENAI_BASE_URL=""
AI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Gemini (optional alternative provider)
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# Secrets (required for BYOK)
# -----------------------------------------------------------------------------

# Used to encrypt/decrypt user-provided API keys stored in the DB (AES-GCM).
# Set this to a long random string and keep it stable across web + agents deploys.
TI_SECRETS_KEY=""

# -----------------------------------------------------------------------------
# Ingestion sources / external APIs
# -----------------------------------------------------------------------------

NVD_API_KEY=""
GITHUB_TOKEN=""
MALWAREBAZAAR_API_KEY=""
ANYRUN_API_KEY=""

# -----------------------------------------------------------------------------
# App URLs (used in outbound integrations like Jira Automation payloads)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Clerk (auth)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Optional Clerk routing overrides
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Local dev helpers (Navigator / custom agents)
# -----------------------------------------------------------------------------

NAVIGATOR_LOCAL_CLERK_ID="local"
NAVIGATOR_LOCAL_EMAIL="local@threat-intel.dev"
# free | pro (default is pro in local dev)
NAVIGATOR_LOCAL_TIER="pro"
# Set to "1" to bypass Pro gating in local dev
NAVIGATOR_BYPASS_PRO="0"

# Include inferred scenarios when recomputing Navigator
NAVIGATOR_AGENT_INCLUDE_INFERRED="1"

# -----------------------------------------------------------------------------
# Agents (AWS Lambda)
# -----------------------------------------------------------------------------
#
# /api/agents/run enqueues runs by invoking an on-demand Lambda asynchronously.
# Provide your AWS region and the function name or ARN.
#
AWS_REGION=""
AGENTS_ON_DEMAND_LAMBDA_NAME=""
# Alternative to AGENTS_ON_DEMAND_LAMBDA_NAME
AGENTS_ON_DEMAND_LAMBDA_ARN=""

# -----------------------------------------------------------------------------
# Agent tuning (optional)
# -----------------------------------------------------------------------------

# ExploitAgent
EXPLOIT_AGENT_LOOKBACK_HOURS="24"
EXPLOIT_AGENT_MAX_PER_RUN="120"
# Per-run budget for NVD CVE lookups (0 disables NVD calls). Default is enough to score
# all unique CVEs touched in a run, capped at 500.
EXPLOIT_AGENT_NVD_LOOKUPS_MAX="200"
# Backfill unscored exploit findings (recent PoCs).
EXPLOIT_AGENT_BACKFILL_MAX="80"
# How far back to search for unscored exploit findings when backfilling.
EXPLOIT_AGENT_BACKFILL_LOOKBACK_DAYS="30"
