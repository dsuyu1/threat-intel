    "start": "next start",
    "lint": "next lint",
    "pretypecheck": "node ./scripts/generate-learn.mjs",
    "typecheck": "node ./scripts/clean-typecheck-artifacts.mjs && node --max_old_space_size=4096 ./node_modules/typescript/bin/tsc --noEmit"
  },
