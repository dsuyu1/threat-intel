{
  "name": "threat-intel-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @ti/db db:migrate",
    "agents:run": "pnpm --filter agents run:all",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck --concurrency=1"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
